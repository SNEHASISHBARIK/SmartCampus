# ==========================================
# SmartCampus Root .gitignore
# ==========================================

# 1. Dependency Directories
node_modules/
*/node_modules/
backend/node_modules/
frontend/node_modules/

# 2. Python Virtual Environments & Bytecode
.venv/
*/.venv/
backend/ai-service/.venv/
venv/
env/
__pycache__/
*/__pycache__/
backend/ai-service/__pycache__/
*.py[cod]
*$py.class
.Python
.tox/
.nox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# 3. Environment Secrets & Local Configurations
.env
**/.env
.env.*
**/.env.*
*.env
.envrc
*.secret
*.secret.*
*.credentials
*.credentials.*
.env.local
.env.*.local
backend/.env
backend/ai-service/.env
frontend/.env
frontend/.env.local

# Explicitly preserve template files:
!.env.example
!*/.env.example
!**/.env.example
!backend/.env.example
!backend/ai-service/.env.example
!frontend/.env.example

# Local private keys and certificates
*.pem
*.key
*.p12
*.pfx

# 4. Production Builds & Compiled Assets
dist/
dist-ssr/
frontend/dist/
build/
coverage/
.nyc_output/
.vite/
.cache/
.parcel-cache/
.next/
.nuxt/
.turbo/
*.tsbuildinfo
*.local

# Root has no package.json; this orphan lockfile is not an install manifest.
/package-lock.json

# 5. Operating System Metadata
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# 6. IDEs & Code Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# 7. Local Logs & Process Records
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp
*.swp
*.swo
*~

# 8. User Uploads (Ignore uploaded content, preserve directory with .gitkeep)
backend/uploads/question-papers/*
!backend/uploads/question-papers/.gitkeep
backend/uploads/submissions/*
!backend/uploads/submissions/.gitkeep

# Local screenshots contain resume or test-personal data, or have viewport clipping.
docs/screenshots/resume-analyzer.png
docs/screenshots/home-live.png
docs/screenshots/login-live.png
docs/screenshots/placement-page-live.png

# 9. Local Databases & Dumps
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.bson
*.dump
dump.rdb

# 10. AI Assistant & Workspace Metadata
.agent/
.agents/
.gemini/
.gsd/
model_capabilities.yaml

# 11. Local GSD files and root support directories
/GSD-STYLE.md
/PROJECT_RULES.md
/scripts/
/adapters/
